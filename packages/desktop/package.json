{
  "name": "@future-ppt/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Future PPT desktop host for HyperFrames Studio",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "bun run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hyperframes/cli": "workspace:*",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.futureppt.desktop",
    "productName": "Future PPT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "ui/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/esbuild/**",
      "**/@esbuild/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
